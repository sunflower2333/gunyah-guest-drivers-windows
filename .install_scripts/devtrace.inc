/* Bisection set: only these slots are replaced when tracing is enabled. */
/* Slot 0x60 is pfnCheckMultisampleQualityLevels.  Mesa's implementation asks the
 * gallium screen whether each format supports the sample count, which reaches
 * zink and then Turnip.  This minimal correctly-typed replacement never touches
 * the screen, isolating whether that query is what breaks device creation.
 *   void (D3D10DDI_HDEVICE, DXGI_FORMAT, UINT SampleCount, UINT *pNumQualityLevels) */
static void w_check_msaa(void *hDevice, u32 format, u32 sampleCount, u32 *pNum)
{
    (void)hDevice; (void)format;
    if (!pNum) return;
    *pNum = (sampleCount == 1 || sampleCount == 2 || sampleCount == 4 || sampleCount == 8) ? 1u : 0u;
}

static const u32 g_stub_only[] = { 0x60 };;

static void trace_all_device_funcs(void **tbl)
{
    u32 i, j;
    if (!tbl || !tracing_enabled()) return;
    log_str("  *** tracing mode ***\n");
    for (j = 0; j < sizeof(g_stub_only) / sizeof(g_stub_only[0]); j++) {
        i = g_stub_only[j];
        if (i < D3D11_DEVICEFUNCS_MEMBERS) {
            tbl[i] = (i == 0x60) ? (void *)w_check_msaa : g_dev_stubs[i];
            log_hex64("  replaced slot=", (u64)i);
        }
    }
}

